# Switch / checkbox structure, theme and motion presets.
#
# The shape and theme attributes select CSS-variable presets. The motion engine
# snapshots the old computed variables, then tweens colors, lengths, radii and
# positions to the new state. Stagger spreads the tween across the parts.

state on = true
state shape = "pill"
state theme = "accent"
state motion = "morph"

fn toggle() -> null {
	on = on == false
}

fn setPill() -> null {
	shape = "pill"
}

fn setIOS() -> null {
	shape = "ios"
}

fn setMaterial() -> null {
	shape = "material"
}

fn setSquare() -> null {
	shape = "square"
}

fn setAccent() -> null {
	theme = "accent"
}

fn setSuccess() -> null {
	theme = "success"
}

fn setDanger() -> null {
	theme = "danger"
}

fn setMono() -> null {
	theme = "mono"
}

fn setMorph() -> null {
	motion = "morph"
}

fn setFade() -> null {
	motion = "fade"
}

fn setScale() -> null {
	motion = "scale"
}

css ".toggle-page \\{ max-width: 820px; margin: 0 auto; padding: 28px; display: flex; flex-direction: column; gap: 16px; \\} .toggle-note \\{ color: #8fa0b8; font-size: 13px; \\} .toggle-stage \\{ display: flex; align-items: center; gap: 16px; flex-wrap: wrap; padding: 20px; border: 1px solid #3a4152; border-radius: 12px; background: #1a1f29; \\} .toggle-buttons \\{ display: flex; gap: 8px; flex-wrap: wrap; \\}"

view main {
	title "Toggle presets"
	col class: "toggle-page" {
		h1 "Toggle presets"
		p "Change structure, theme and animation while the switch and checkbox morph between the two states." class: "toggle-note"

		div class: "toggle-stage" {
			switch "Modalità" shape: shape theme: theme checked: on animation: motion duration: "360ms" easing: "ease-in-out" onChange: toggle
			checkbox "Accetta i termini" shape: "ios" theme: theme checked: on animation: motion duration: "360ms" easing: "ease-in-out" onChange: toggle
		}

		p "Struttura: {shape} · Tema: {theme} · Animazione: {motion}" class: "toggle-note"

		div class: "toggle-buttons" {
			button "Pill" onClick: setPill
			button "iOS" onClick: setIOS
			button "Material" onClick: setMaterial
			button "Square" onClick: setSquare
		}
		div class: "toggle-buttons" {
			button "Accent" onClick: setAccent
			button "Success" onClick: setSuccess
			button "Danger" onClick: setDanger
			button "Mono" onClick: setMono
		}
		div class: "toggle-buttons" {
			button "Morph" onClick: setMorph
			button "Fade" onClick: setFade
			button "Scale" onClick: setScale
		}
		p "Click the switch or the checkbox to toggle both. The shape/theme buttons morph the parts; the animation buttons change the effect used on the next toggle." class: "toggle-note"
	}
}
