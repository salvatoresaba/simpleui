import { fs } from "std"

# Build with capability:
#   simpleui build fs_operations.sui --target desktop --out dist --allow-dir C:/data
# All paths, including the destination, are checked by the bridge.

css "body \{ margin: 0; padding: 28px; background: #0f1117; color: #e6e6ef; font-family: system-ui, sans-serif; \}
.card \{ max-width: 760px; padding: 20px 22px; border: 1px solid #2c3444; border-radius: 10px; background: #151922; \}
pre \{ white-space: pre-wrap; font-size: 12px; \}"

state base = "C:/data"
state source = "report.txt"
state target = "report-copy.txt"
state out = "ready"

fn safeName(name: string) -> bool {
	if contains(name, "..") or contains(name, "/") or contains(name, "\\") {
		return false
	}
	return len(name) > 0
}

async fn copyFile() -> null {
	if not safeName(source) or not safeName(target) {
		out = "blocked: names must stay inside the allowed directory"
		return
	}
	let src = path.join(base, source)
	let dst = path.join(base, target)
	copyOk, err = fs.copy(src, dst)
	out = err == null ? "copied " + source + " -> " + target : err
}

async fn moveFile() -> null {
	if not safeName(source) or not safeName(target) {
		out = "blocked: names must stay inside the allowed directory"
		return
	}
	let src = path.join(base, source)
	let dst = path.join(base, target)
	moveOk, err = fs.move(src, dst)
	out = err == null ? "moved " + source + " -> " + target : err
}

async fn inspect() -> null {
	if not safeName(source) {
		out = "blocked: invalid file name"
		return
	}
	let p = path.join(base, source)
	isDir, derr = fs.isDir(p)
	if derr != null {
		out = derr
		return
	}
	size, serr = fs.size(p)
	if serr != null {
		out = "dir=" + str(isDir) + " · " + serr
	} else {
		out = "dir=" + str(isDir) + " · size=" + str(size) + " bytes"
	}
}

view main {
	card "" class: "card" {
		h1 "Desktop fs operations"
		p "Base directory: {base}" class: "muted"
		input "Source" value: source
		input "Target" value: target
		row {
			button "Inspect" onClick: inspect
			button "Copy" onClick: copyFile
			button "Move / rename" onClick: moveFile
		}
		pre "{out}"
		p "Copy accepts regular files only. Move/rename also accepts directories. Both source and destination must be under --allow-dir. On web these calls return an error." class: "muted"
	}
}
