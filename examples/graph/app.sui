# Graph control: a block diagram built from states and transitions.
# Duplicate this file from the designer (Controls > Graph) or edit it here.
state orderFlow = "\{\"states\":[\{\"id\":\"intake\",\"label\":\"Intake\",\"shape\":\"rectangle\",\"x\":40,\"y\":100,\"w\":130,\"h\":60,\"tag\":\"entry|point\"\},\{\"id\":\"validate\",\"label\":\"Validate?\",\"shape\":\"rhombus\",\"x\":220,\"y\":84,\"w\":120,\"h\":92,\"tag\":\"decision\"\},\{\"id\":\"approve\",\"label\":\"Approve\",\"shape\":\"rectangle\",\"x\":400,\"y\":100,\"w\":130,\"h\":60\},\{\"id\":\"reject\",\"label\":\"Reject\",\"shape\":\"rectangle\",\"x\":220,\"y\":240,\"w\":130,\"h\":60\}],\"transitions\":[\{\"from\":\"intake\",\"to\":\"validate\",\"label\":\"submit\",\"tag\":\"request\"\},\{\"from\":\"validate\",\"to\":\"approve\",\"label\":\"ok\",\"tag\":\"approved|queue\"\},\{\"from\":\"validate\",\"to\":\"reject\",\"label\":\"fail\"\},\{\"from\":\"reject\",\"to\":\"intake\",\"label\":\"retry\"\}]\}"

view main {
	title "Graph control"
	col class: "graph-page" {
		header class: "graph-hero" {
			p "SimpleUI block diagram" class: "graph-kicker"
			h1 "Order approval flow" class: "graph-title"
			p "One graph control renders boxes, links, tags and a synchronized table. Use | for a line break in tag and hint text." class: "graph-subtitle"
		}

		card class: "graph-card" {
			graph "Order approval flow" name: "order_flow" class: "graph-canvas" data: orderFlow stateRouting: "curved" stateTagLink: "line" stateShapeTagStyle: "pill" stateShapeTagLink: "arrow" stateLinkTagStyle: "box" stateLinkTagLink: "line" stateTagFontSize: 11 stateGrid: true stateGridGap: 24 stateGridColor: "#cbd5e1" tableView: "both" tableFilters: false showGrid: false showLegend: false showValues: true editMode: "persistent" theme: "light" style: cssSafe("--sui-chart-series-1: #0284c7; --sui-chart-series-2: #16a34a; --sui-chart-series-3: #d97706; --sui-chart-series-4: #9333ea; --sui-chart-gantt-dependency: #64748b; --sui-chart-fg: #102a43; --sui-chart-muted: #64748b; --sui-chart-bg: #ffffff;")
		}

		row class: "graph-help" {
			p "Insert it from Controls > Graph; it is a leaf control, so it cannot contain children." class: "graph-note"
			p "Change the data from the inspector overlay: JSON, CSV and XML are accepted." class: "graph-note"
			p "Element hints edits every state and link without rewriting the source by hand." class: "graph-note"
		}
	}
}

css "body \{ margin: 0; background: #f3f7fb; \} .graph-page \{ max-width: 1180px; margin: 0 auto; padding: 24px; display: flex; flex-direction: column; gap: 16px; background: #f3f7fb; min-height: 100vh; \} .graph-hero \{ padding: 22px 24px; border: 1px solid #cbd9e8; border-radius: 16px; background: linear-gradient(135deg, #ffffff 0%, #eaf4ff 100%); box-shadow: 0 8px 24px rgba(15,54,90,.08); \} .graph-kicker \{ margin: 0 0 6px; color: #0369a1; font-size: 12px; font-weight: 750; letter-spacing: 1.4px; text-transform: uppercase; \} .graph-title \{ margin: 0; color: #0f2740; font-size: 30px; line-height: 1.1; \} .graph-subtitle \{ margin: 8px 0 0; max-width: 760px; color: #526b84; font-size: 13px; line-height: 1.5; \} .graph-card \{ border: 1px solid #d5e1ee; border-radius: 14px; background: #ffffff; padding: 12px; box-shadow: 0 3px 12px rgba(15,54,90,.05); \} .graph-canvas \{ width: 100%; height: 560px; \} .graph-help \{ display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px 20px; \} .graph-note \{ margin: 0; color: #526b84; font-size: 12px; line-height: 1.55; \} @media (max-width: 760px) \{ .graph-help \{ grid-template-columns: 1fr; \} .graph-title \{ font-size: 24px; \} .graph-canvas \{ height: 500px; \} \}"
