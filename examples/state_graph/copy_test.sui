state orderState = "\{\"initial\":\"idle\",\"states\":[\{\"id\":\"idle\",\"label\":\"Idle\",\"type\":\"initial\",\"description\":\"Waiting for an order\"\},\{\"id\":\"validating\",\"label\":\"Validating\",\"description\":\"Check stock and payment\",\"shape\":\"stadium\",\"borderStyle\":\"solid\",\"borderWidth\":1.5,\"cornerRadius\":18,\"tag\":\"Stock and payment check\"\},\{\"id\":\"paymentChoice\",\"label\":\"Payment?\",\"type\":\"choice\"\},\{\"id\":\"paid\",\"label\":\"Paid\",\"description\":\"Payment captured\"\},\{\"id\":\"cancelled\",\"label\":\"Cancelled\",\"type\":\"final\"\},\{\"id\":\"shipped\",\"label\":\"Shipped\",\"type\":\"final\"\}],\"transitions\":[\{\"from\":\"idle\",\"to\":\"validating\",\"event\":\"submit\",\"label\":\"submit\"\},\{\"from\":\"validating\",\"to\":\"paymentChoice\",\"event\":\"valid\",\"label\":\"valid\"\},\{\"from\":\"validating\",\"to\":\"cancelled\",\"event\":\"invalid\",\"label\":\"invalid\"\},\{\"from\":\"paymentChoice\",\"to\":\"paid\",\"event\":\"capture\",\"guard\":\"payment.ok\",\"action\":\"reserveStock()\"\},\{\"from\":\"paymentChoice\",\"to\":\"cancelled\",\"event\":\"decline\"\},\{\"from\":\"paid\",\"to\":\"shipped\",\"event\":\"dispatch\",\"guard\":\"stock.ready\",\"linkType\":\"bezier\",\"width\":2,\"dashStyle\":\"solid\"\},\{\"from\":\"validating\",\"to\":\"validating\",\"event\":\"retry\",\"label\":\"retry\"\}]\}"

view main {
	title "Order state machine"
	col class: "state-page" {
		header class: "state-hero" {
			p "SimpleUI state machine" class: "state-kicker"
			h1 "Order lifecycle" class: "state-title"
			p "States, transitions, events, guards and actions rendered from one JSON state machine. Use the table to inspect the same data." class: "state-subtitle"
		}

		card class: "state-card" {
			graph "Order state machine" name: "order_state" class: "state-chart" data: orderState stateTagLink: "line" stateShapeTagStyle: "pill" stateShapeTagLink: "arrow" stateLinkTagStyle: "box" stateLinkTagLink: "line" stateTagFontSize: 11 stateGrid: true stateGridGap: 24 stateGridColor: "#cbd5e1" tableView: "both" tableFilters: false showGrid: false showLegend: false showValues: true editMode: "persistent" theme: "light" style: cssSafe("--sui-chart-series-1: #0284c7; --sui-chart-series-2: #16a34a; --sui-chart-series-3: #d97706; --sui-chart-series-4: #9333ea; --sui-chart-gantt-dependency: #64748b; --sui-chart-fg: #102a43; --sui-chart-muted: #64748b; --sui-chart-bg: #ffffff;")
		}

		row class: "state-help" {
			p "Initial state: drawn as a filled circle. Final states: double rings." class: "state-note"
			p "Choice: diamond. Self-loops and guards are rendered from transition data." class: "state-note"
			p "Keyboard: Tab focuses states and transition labels; the chart root supports arrow navigation through marks." class: "state-note"
		}
	}
}

css "body \{ margin: 0; background: #f3f7fb; \} .state-page \{ max-width: 1180px; margin: 0 auto; padding: 24px; display: flex; flex-direction: column; gap: 16px; background: #f3f7fb; min-height: 100vh; \} .state-hero \{ padding: 22px 24px; border: 1px solid #cbd9e8; border-radius: 16px; background: linear-gradient(135deg, #ffffff 0%, #eaf4ff 100%); box-shadow: 0 8px 24px rgba(15,54,90,.08); \} .state-kicker \{ margin: 0 0 6px; color: #0369a1; font-size: 12px; font-weight: 750; letter-spacing: 1.4px; text-transform: uppercase; \} .state-title \{ margin: 0; color: #0f2740; font-size: 30px; line-height: 1.1; \} .state-subtitle \{ margin: 8px 0 0; max-width: 760px; color: #526b84; font-size: 13px; line-height: 1.5; \} .state-card \{ border: 1px solid #d5e1ee; border-radius: 14px; background: #ffffff; padding: 12px; box-shadow: 0 3px 12px rgba(15,54,90,.05); \} .state-chart \{ width: 100%; height: 620px; \} .state-help \{ display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px 20px; \} .state-note \{ margin: 0; color: #526b84; font-size: 12px; line-height: 1.55; \} @media (max-width: 760px) \{ .state-help \{ grid-template-columns: 1fr; \} .state-title \{ font-size: 24px; \} .state-chart \{ height: 540px; \} \}"
